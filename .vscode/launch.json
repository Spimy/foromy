{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ForoMy.Web",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/ForoMy.Web/ForoMy.Web.csproj"
    },
    {
      "name": "Attach to running app",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}